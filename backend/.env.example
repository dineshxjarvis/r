# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local
DEBUG=true

# Connect as strata_app (LOGIN, NOBYPASSRLS) — never as the Supabase service
# role or the `postgres` owner, which silently bypasses every RLS policy.
#
# Supabase's direct db.<ref>.supabase.co host is IPv6-only. Use the session
# pooler on IPv4; transaction-mode pooling breaks SET LOCAL and therefore RLS.
# URL-encode reserved characters in the password (* is %2A, $ is %24).
DATABASE_URL=postgresql+asyncpg://strata_app:CHANGE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=strata
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET_ORIGINALS=strata-originals
STORAGE_BUCKET_DERIVED=strata-derived

OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# Demo escape hatch. Skips step 5 of the authorization chain (the OpenFGA
# graph check) so the API runs before a store is provisioned. Every other
# step still applies: session, scope, capability, assurance, state
# precondition, separation of duties, audit. Startup refuses this in
# production.
AUTHZ_SKIP_GRAPH_CHECK=true

CORS_ORIGINS=["http://localhost:3000"]
